# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,mjs,cjs,json,jsonc,json5,yml,yaml,html,scss,css,vue}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
indent_size = 2

[*.{java,kt}]
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab

[*.{xml,pom}]
indent_size = 2
